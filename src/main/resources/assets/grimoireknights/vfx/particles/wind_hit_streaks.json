{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "grimoireknights:wind_hit_streaks",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/wind_streak"
			}
		},
		"components": {
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "6 + variable.bonus * 24"
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					0,
					0,
					0
				],
				"radius": 0.2,
				"surface_only": false,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2, 0.35)"
			},
			"minecraft:particle_initial_speed": "math.random(3, 5) * (1 + variable.bonus * 2.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					0,
					0
				],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"math.lerp(0.5, 0.2, variable.particle_age / variable.particle_lifetime) * (1 + variable.bonus * 2.5)",
					"0.1 * (1 + variable.bonus * 2.5)"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				},
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"gradient": {
						"0.00": [
							1,
							1,
							1,
							0.9
						],
						"0.60": [
							0.93,
							0.96,
							0.98,
							0.6
						],
						"1.00": [
							0.85,
							0.9,
							0.95,
							0
						]
					},
					"interpolant": "variable.particle_age / variable.particle_lifetime"
				}
			}
		}
	}
}
