{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "grimoireknights:gale_bow_dissipate_wisps",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/wind_wisp"
			}
		},
		"components": {
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 16
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.4, 0.6)"
			},
			"minecraft:particle_initial_speed": "math.random(1.5, 3)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					0.6,
					0
				],
				"linear_drag_coefficient": 2.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"math.lerp(0.45, 1.2, variable.particle_age / variable.particle_lifetime)",
					"math.lerp(0.45, 1.2, variable.particle_age / variable.particle_lifetime)"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							16,
							16
						],
						"step_UV": [
							0,
							16
						],
						"frames_per_second": 8,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-40, 40)"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"gradient": {
						"0.00": [
							1,
							1,
							1,
							0
						],
						"0.15": [
							1,
							1,
							1,
							0.8
						],
						"0.60": [
							0.93,
							0.96,
							0.98,
							0.5
						],
						"1.00": [
							0.85,
							0.9,
							0.95,
							0
						]
					},
					"interpolant": "variable.particle_age / variable.particle_lifetime"
				}
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"(variable.aimed > 0 ? variable.right_x : 1) * math.lerp(-1.8, 1.8, variable.particle_random_1)",
					"math.random(-0.1, 0.1)",
					"(variable.aimed > 0 ? variable.right_z : 0) * math.lerp(-1.8, 1.8, variable.particle_random_1)"
				],
				"direction": [
					"(variable.aimed > 0 ? variable.fwd_x : 0) * 1.2 + math.random(-0.7, 0.7)",
					"variable.fwd_y * 1.2 + math.random(-0.2, 0.6)",
					"(variable.aimed > 0 ? variable.fwd_z : 1) * 1.2 + math.random(-0.7, 0.7)"
				]
			}
		}
