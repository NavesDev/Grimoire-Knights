{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "grimoireknights:dash_trail_lines",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/dash_streak"
			}
		},
		"components": {
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 2
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.15, 0.25)"
			},
			"minecraft:particle_initial_speed": "math.random(1, 2)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					0,
					0
				],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"math.lerp(1.0, 0.4, variable.particle_age / variable.particle_lifetime)",
					"math.lerp(0.22, 0.11, variable.particle_age / variable.particle_lifetime)"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				},
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"gradient": {
						"0.00": [
							0.62,
							0.85,
							1,
							0.95
						],
						"0.45": [
							0.25,
							0.58,
							0.95,
							0.75
						],
						"1.00": [
							0.1,
							0.32,
							0.8,
							0
						]
					},
					"interpolant": "variable.particle_age / variable.particle_lifetime"
				}
			},
			"minecraft:emitter_shape_box": {
				"offset": [
					0,
					0.9,
					0
				],
				"half_dimensions": [
					0.35,
					0.7,
					0.35
				],
				"surface_only": false,
				"direction": [
					"(variable.dir_x == 0 && variable.dir_z == 0) ? -1 : -variable.dir_x",
					0,
					"(variable.dir_x == 0 && variable.dir_z == 0) ? 0 : -variable.dir_z"
				]
			}
		}
